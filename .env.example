# Base URL of your waitlist API (no trailing slash). Leave empty to use the built-in mock.
VITE_API_BASE_URL=

# Launch moment, ISO 8601. Include a timezone offset (Z = UTC, +01:00 = Lagos).
VITE_LAUNCH_DATE=2027-01-11T00:00:00Z

# Force the mock service even when VITE_API_BASE_URL is set.
VITE_USE_MOCK=false

# Starting number shown by the mock service.
VITE_MOCK_WAITLIST_COUNT=12438
